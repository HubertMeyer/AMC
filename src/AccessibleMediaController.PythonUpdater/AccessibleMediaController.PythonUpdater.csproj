<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AssemblyName>AMC-Python-Updater</AssemblyName>
    <RootNamespace>AccessibleMediaController.PythonUpdater</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ReleaseProfileContract.cs" Link="ReleaseProfileContract.cs" />
    <Compile Include="..\Shared\PostUpdateLaunchContract.cs" Link="PostUpdateLaunchContract.cs" />
  </ItemGroup>
</Project>
