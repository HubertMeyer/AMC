<Window x:Class="AccessibleMediaController.Windows.FrontierSmartDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Urządzenia Frontier Smart" Width="780" Height="610" MinWidth="660" MinHeight="490"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Urządzenia Frontier Smart" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="AMC przy pierwszym otwarciu automatycznie szuka odbiorników Frontier Smart w sieci lokalnej. Wykryte urządzenie pojawi się na liście bez podawania adresu. PIN jest potrzebny dopiero do połączenia; AMC zapisuje go bezpiecznie w Menedżerze poświadczeń Windows." />
            <Label Margin="0,8,0,0" Target="{Binding ElementName=PinBox}">_PIN wybranego urządzenia:</Label>
            <PasswordBox x:Name="PinBox" Width="180" HorizontalAlignment="Left" MaxLength="16"
                         automation:AutomationProperties.Name="PIN urządzenia Frontier Smart"
                         automation:AutomationProperties.HelpText="Od 1 do 16 cyfr. Wpisz po wybraniu wykrytego urządzenia. Częstą wartością fabryczną jest 1234." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <controls:AccessibleStatusTextBlock x:Name="OperationStatusText" Margin="0,0,0,8" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Wynik operacji"
                       automation:AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel HorizontalAlignment="Left">
                <Button x:Name="DiscoverButton" Margin="0,0,8,8" Content="_Wykryj nowe urządzenia" Click="Discover_Click" />
                <Button x:Name="ConnectButton" Margin="0,0,8,8" Content="_Połącz i dodaj"
                        automation:AutomationProperties.HelpText="Łączy zaznaczone wykryte urządzenie przy użyciu wpisanego PIN-u."
                        Click="Connect_Click" />
                <Button x:Name="ActivateButton" Margin="0,0,8,8" Content="_Ustaw jako aktywne"
                        automation:AutomationProperties.HelpText="Enter na urządzeniu wykonuje to samo polecenie."
                        Click="Activate_Click" />
                <Button x:Name="RefreshButton" Margin="0,0,8,8" Content="_Odśwież wybrane" Click="Refresh_Click" />
                <Button x:Name="RemoveButton" Margin="0,0,8,8" Content="_Usuń urządzenie…" Click="Remove_Click" />
                <Button x:Name="CreateSessionButton" Margin="0,0,8,8" Content="U_twórz sesję" IsDefault="True"
                        Visibility="Collapsed" Click="CreateSession_Click" />
                <Button x:Name="CloseButton" Margin="0,0,0,8" Content="_Zamknij" IsCancel="True" />
            </WrapPanel>
            <Expander x:Name="ManualAddressExpander" Header="Dodawanie ręczne po adresie IP" IsExpanded="False"
                      automation:AutomationProperties.HelpText="Użyj, gdy automatyczne wykrywanie nie znajduje urządzenia.">
                <StackPanel Margin="12,6,0,0">
                    <Label Target="{Binding ElementName=AddressBox}">_Adres IP urządzenia:</Label>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBox x:Name="AddressBox" Width="230" Margin="0,0,8,0"
                                 automation:AutomationProperties.Name="Adres IP urządzenia Frontier Smart"
                                 automation:AutomationProperties.HelpText="Przykład: 192.168.1.25" />
                        <Button x:Name="AddButton" Content="_Dodaj i sprawdź" Click="Add_Click" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="DevicesList" DisplayMemberPath="Label" TextSearch.TextPath="NavigationText"
                     automation:AutomationProperties.Name="Urządzenia Frontier Smart"
                     automation:AutomationProperties.HelpText="Strzałki wybierają urządzenie. Enter łączy wykryte urządzenie albo ustawia zapisane jako aktywne."
                     SelectionChanged="DevicesList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="DeviceDetailsText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Szczegóły wybranego urządzenia" />
        </Grid>
    </DockPanel>
</Window>
