<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.YouTubeGoogleAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Konto YouTube i import z Google" Width="760" Height="560"
        MinWidth="620" MinHeight="470" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Konto YouTube i import z Google" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Logowanie odbywa się na oficjalnej stronie Google w zwykłej przeglądarce. AMC otrzymuje tylko odczyt subskrypcji i własnych playlist YouTube. Hasło Google nie trafia do AMC." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <controls:AccessibleStatusTextBlock x:Name="StatusText" Margin="0,0,0,10"
                                                TextWrapping="Wrap"
                                                automation:AutomationProperties.Name="Stan konta YouTube"
                                                automation:AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel>
                <Button x:Name="SaveButton" Content="_Zapisz Client ID" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="Zapisz identyfikator klienta Google"
                        Click="Save_Click" />
                <Button x:Name="LoginButton" Content="Za_loguj kontem Google" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="Zaloguj konto Google w zwykłej przeglądarce"
                        Click="Login_Click" />
                <Button x:Name="ImportButton" Content="_Importuj subskrypcje i playlisty" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="Importuj subskrybowane kanały i własne playlisty YouTube"
                        Click="Import_Click" />
                <Button x:Name="SignOutButton" Content="_Wyloguj konto" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="Wyloguj konto Google z AMC"
                        Click="SignOut_Click" />
                <Button x:Name="RemoveButton" Content="Usuń _konfigurację…" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="Usuń konfigurację i logowanie YouTube"
                        Click="Remove_Click" />
                <Button x:Name="CloseButton" Content="Za_mknij" IsCancel="True" Margin="0,0,0,8"
                        automation:AutomationProperties.Name="Zamknij okno konta YouTube" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Label Target="{Binding ElementName=ClientIdBox}">Google OAuth _Client ID:</Label>
                <TextBox x:Name="ClientIdBox" MaxLength="300" Margin="0,0,0,12"
                         automation:AutomationProperties.Name="Identyfikator klienta Google typu Aplikacja na komputer"
                         automation:AutomationProperties.HelpText="Wklej publiczny Client ID kończący się na .apps.googleusercontent.com. Nie wpisuj sekretu klienta." />

                <TextBlock Text="Co zostanie zaimportowane" FontWeight="SemiBold"
                           automation:AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                           Text="Subskrybowane kanały oraz playlisty należące do zalogowanego konta zostaną scalone z Biblioteką sesji Podcasty i YouTube. Istniejące pozycje nie są usuwane. Z kanałów pobieranych jest do 15 najnowszych materiałów, a z każdej playlisty do 100 pozycji." />

                <TextBlock Text="Ważne ograniczenie odtwarzania" FontWeight="SemiBold"
                           automation:AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                           Text="Token YouTube Data API służy do odczytu biblioteki. Nie jest przekazywany do yt-dlp i nie omija ograniczeń wieku, regionu, treści prywatnych ani zabezpieczeń YouTube. Publiczne materiały odtwarzają się dotychczasowym mechanizmem AMC." />

                <TextBlock Text="Co przygotowuje właściciel projektu Google" FontWeight="SemiBold"
                           automation:AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="Włącza YouTube Data API v3, konfiguruje ekran zgody OAuth i tworzy Client ID typu Aplikacja na komputer. Do AMC przekazuje wyłącznie publiczny Client ID. Sekret klienta nie jest potrzebny i nie powinien trafiać do repozytorium." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</controls:AccessibleWindow>
