<Window x:Class="AccessibleMediaController.Windows.FrontierSmartChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Width="520" Height="410" MinWidth="430" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" Margin="0,0,0,10"
                   FontSize="18" FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <controls:AccessibleStatusTextBlock x:Name="StatusText" Margin="0,0,0,8"
                automation:AutomationProperties.Name="Wynik wyboru"
                automation:AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="100" Margin="0,0,8,0" Content="_Wybierz" IsDefault="True" Click="Choose_Click" />
                <Button Width="100" Content="_Anuluj" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="ChoiceList" DisplayMemberPath="Label" TextSearch.TextPath="NavigationText"
                 automation:AutomationProperties.Name="Dostępne opcje"
                 MouseDoubleClick="ChoiceList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
