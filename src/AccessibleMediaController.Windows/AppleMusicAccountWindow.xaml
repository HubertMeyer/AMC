<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.AppleMusicAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Konto Apple Music — prototyp" Width="720" Height="520"
        MinWidth="580" MinHeight="430" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Konto Apple Music — prototyp" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="AMC używa oficjalnego MusicKit on the Web. Hasło podajesz wyłącznie w oknie Apple, a AMC zapisuje tokeny w Menedżerze poświadczeń Windows. Prywatnego klucza .p8 nie wolno tu wklejać." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <controls:AccessibleStatusTextBlock x:Name="StatusText" Margin="0,0,0,10"
                                                TextWrapping="Wrap"
                                                automation:AutomationProperties.Name="Stan konta Apple Music"
                                                automation:AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel>
                <Button x:Name="SaveButton" Content="Zapisz i _sprawdź token" Margin="0,0,8,8"
                        Click="Save_Click" />
                <Button x:Name="LoginButton" Content="Za_loguj kontem Apple" Margin="0,0,8,8"
                        Click="Login_Click" />
                <Button x:Name="SyncButton" Content="_Pobierz bibliotekę" Margin="0,0,8,8"
                        Click="Sync_Click" />
                <Button x:Name="SignOutButton" Content="_Wyloguj konto" Margin="0,0,8,8"
                        Click="SignOut_Click" />
                <Button x:Name="RemoveButton" Content="Usuń _konfigurację…" Margin="0,0,8,8"
                        Click="Remove_Click" />
                <Button Content="Za_mknij" IsCancel="True" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=DeveloperTokenBox}">Token _deweloperski:</Label>
                <PasswordBox x:Name="DeveloperTokenBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                             automation:AutomationProperties.Name="Token deweloperski Apple Music"
                             automation:AutomationProperties.HelpText="Wklej podpisany JWT. Nie wklejaj prywatnego klucza .p8, Team ID ani Key ID." />

                <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=StorefrontBox}">_Katalog kraju:</Label>
                <TextBox x:Name="StorefrontBox" Grid.Row="1" Grid.Column="1" Width="80" MaxLength="2"
                         HorizontalAlignment="Left" Margin="8,0,0,8"
                         automation:AutomationProperties.Name="Dwuliterowy kod katalogu Apple Music"
                         automation:AutomationProperties.HelpText="Dla Polski wpisz pl." />

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" FontWeight="SemiBold"
                           Text="Co jest potrzebne od właściciela Apple Developer"
                           automation:AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="Media ID z włączonym MusicKit, klucz Media Services oraz podpisany developer token JWT. Do repozytorium i do tego okna przekazuje się wyłącznie gotowy JWT. Użytkownik końcowy wybiera potem Zaloguj kontem Apple. Pełne odtwarzanie wymaga aktywnej subskrypcji Apple Music; zgodność DRM z WebView2 musi zostać potwierdzona na prawdziwym koncie." />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</controls:AccessibleWindow>
